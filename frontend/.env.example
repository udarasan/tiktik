# Copy to .env.local (or run `npm run env:local` from the repo root with the local stack running).
# Browser gets the PUBLISHABLE key only (CLAUDE.md rule 8). Never put a secret / service_role key here.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Optional: Cloudflare Turnstile site key (FR-AUTH-11). Leave empty locally; Supabase CAPTCHA is off.
VITE_TURNSTILE_SITE_KEY=
